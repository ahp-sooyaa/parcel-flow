# PostgreSQL connection string used by Drizzle and Better Auth.
DATABASE_URL=

# Required in every environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used by `bun run db:seed:super-admin` to create the first login user.
FIRST_SUPER_ADMIN_USERNAME=
FIRST_SUPER_ADMIN_PASSWORD=
FIRST_SUPER_ADMIN_NAME=Super Admin
FIRST_SUPER_ADMIN_PHONE_NUMBER=09000000000
FIRST_SUPER_ADMIN_ADDRESS=
FIRST_SUPER_ADMIN_AGE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
