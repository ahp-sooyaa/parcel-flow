# PostgreSQL connection string used by Drizzle and Better Auth.
# Prefer Supabase transaction pooler (port 6543) for Next.js so local + Railway
# share the free-tier pool safely. Session mode (port 5432) caps clients ~15.
# Keep prepare:false in src/db/index.ts when using transaction mode.
DATABASE_URL=

# Required in every environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used by `bun run db:seed:super-admin` to create the first login user.
FIRST_SUPER_ADMIN_USERNAME=
FIRST_SUPER_ADMIN_PASSWORD=
FIRST_SUPER_ADMIN_NAME=Super Admin
FIRST_SUPER_ADMIN_PHONE_NUMBER=09000000000
FIRST_SUPER_ADMIN_ADDRESS=
FIRST_SUPER_ADMIN_AGE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_REFERENCE_BYTES=

CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_REFERENCE_BYTES=

# Same DSN for staging and production. Tag events with the environment name.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional server-only override; falls back to NEXT_PUBLIC_SENTRY_ENVIRONMENT.
SENTRY_ENVIRONMENT=
# Build-time source map upload (Railway / CI). Same token is fine for both envs.
SENTRY_AUTH_TOKEN=

# Public demo mode. "1" enables one-click demo logins, the demo banner, the
# guardrails, and the reset route. Read at build time by the browser bundle,
# so redeploy after changing it.
NEXT_PUBLIC_DEMO_MODE=
# Bearer token for POST /api/demo/reset (the nightly GitHub Actions job).
# Generate with: openssl rand -base64 32
DEMO_RESET_TOKEN=
# Public URL used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
