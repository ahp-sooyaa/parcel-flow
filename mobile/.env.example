# Base URL of the Parcel Flow web app the rider app talks to. Required.
#
# Expo Go on a phone: use your computer's LAN address, and start the web app
# with `bun run dev` (it listens on all interfaces) so the phone can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
#
# A deployed environment:
# EXPO_PUBLIC_API_URL=https://parcel-flow-production.up.railway.app
