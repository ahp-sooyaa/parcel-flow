{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@parcel-flow/contract": ["../src/features/mobile-api/contract.ts"],
      // Type the shared contract against this app's zod, matching metro.config.js.
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
