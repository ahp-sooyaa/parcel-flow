{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["dom", "dom.iterable", "es2025"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["bun-types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/test-db/types/**/*.ts",
    ".next/test-db/dev/types/**/*.ts",
    ".next/demo-local/types/**/*.ts",
    ".next/demo-local/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "mobile"]
}
