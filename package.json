{
  "name": "parcel-flow-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts --fix .",
    "format": "oxfmt --config oxfmt.config.ts --write .",
    "format:check": "oxfmt --config oxfmt.config.ts --check .",
    "test": "bun run test:unit",
    "test:unit": "bun test --preload ./tests/setup/bun-test.ts tests/unit tests/components",
    "test:db:migrate": "bun --env-file=.env.test drizzle-kit migrate",
    "test:integration": "bun run test:db:migrate && bun --env-file=.env.test test --preload ./tests/setup/bun-test.ts tests/integration",
    "test:coverage": "bun run test:db:migrate && bun test --coverage --preload ./tests/setup/bun-test.ts tests/unit tests/components && bun --env-file=.env.test test --coverage --preload ./tests/setup/bun-test.ts tests/integration",
    "test:e2e:seed": "bun --env-file=.env.test tests/e2e/seed.ts",
    "test:e2e": "bun run test:db:migrate && bun run test:e2e:seed && playwright test",
    "test:e2e:instant": "bun run test:db:migrate && bun run test:e2e:seed && playwright test -c playwright.instant.config.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "perf:seed": "bun run test:db:migrate && bun --env-file=.env.test tests/performance/seed.ts",
    "perf:dal": "bun run perf:seed && bun --env-file=.env.test tests/performance/dal.bench.ts",
    "perf:explain": "bun --env-file=.env.test tests/performance/explain.ts",
    "perf:pages": "bun run perf:seed && bun --env-file=.env.test x playwright test -c playwright.perf.config.ts",
    "perf:lighthouse": "bun --env-file=.env.test tests/performance/lighthouse.ts",
    "perf:compare": "bun --env-file=.env.test tests/performance/compare.ts",
    "perf:all": "bun --env-file=.env.test tests/performance/run-all.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset:dev": "bun --env-file=.env.development src/db/reset-development-data.ts && bun run db:seed:super-admin",
    "db:seed:super-admin": "bun --env-file=.env.development src/db/seed-super-admin.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@base-ui/react": "^1.4.1",
    "@next/env": "16.3.0",
    "@sentry/nextjs": "^10",
    "@supabase/supabase-js": "^2.106.2",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "facehash": "^0.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.76.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/playwright": "16.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "lighthouse": "^12.8.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.9"
}
